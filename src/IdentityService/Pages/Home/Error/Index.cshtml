@page
@model IdentityService.Pages.Error.Index

<div class="error-page">
    <div class="error-card">
        <div class="error-icon">
            <img src="~/svgs/icons/ui/error-triangle.svg" alt="" width="64" height="64" class="status-icon status-icon--lg" aria-hidden="true" />
        </div>

        <h1 class="error-title">Oops! Something went wrong</h1>

        @if (Model.View.Error != null)
        {
            <div class="error-message">
                <em>@Model.View.Error.Error</em>
                @if (Model.View.Error.ErrorDescription != null)
                {
                    <div class="error-description">@Model.View.Error.ErrorDescription</div>
                }
            </div>
        }

        <div class="error-actions">
            <a href="/" class="btn-home">Return Home</a>
        </div>

        @if (Model?.View?.Error?.RequestId != null)
        {
            <div class="request-id">Request Id: @Model.View.Error.RequestId</div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/error.css?v=@DateTime.Now.Ticks" />
}
