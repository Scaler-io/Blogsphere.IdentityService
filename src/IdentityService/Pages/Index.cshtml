@page
@model IdentityService.Pages.Home.Index

<div class="landing-page">
    <!-- Hero Section -->
    <div class="hero-section bg-primary py-5 mb-5 landing-hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 col-md-8">
                    <h1 class="display-4 fw-bold text-white mb-3">
                        Secure Identity for Modern Blogs
                    </h1>
                    <p class="text-white mb-4 landing-lead">
                        Power your publishing platform with enterprise-grade authentication, 
                        OAuth2, and OpenID Connect. Built for developers, loved by users.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="~/.well-known/openid-configuration" class="btn btn-hero-primary btn-lg px-4 mr-3">
                            Get Started
                        </a>
                        <a href="~/diagnostics" class="btn btn-hero-secondary btn-lg px-4">
                            Explore
                        </a>
                    </div>
                </div>
                <div class="col-lg-6 col-md-4 text-center">
                    <img src="~/svgs/illustrations/landing/hero-security.svg" alt="" width="280" height="200" class="landing-icon landing-icon--hero" aria-hidden="true" />
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="container mb-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-primary">Why Choose Blogsphere Identity?</h2>
            <p class="lead text-muted">Everything you need for secure, scalable user management</p>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="mb-3">
                            <img src="~/svgs/icons/features/enterprise-security.svg" alt="" width="64" height="64" class="landing-icon landing-icon--feature" aria-hidden="true" />
                        </div>
                        <h5 class="card-title text-primary fw-bold">Enterprise Security</h5>
                        <p class="card-text text-muted">
                            OAuth2, OpenID Connect, and JWT tokens with industry-standard security protocols.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="mb-3">
                            <img src="~/svgs/icons/features/user-management.svg" alt="" width="64" height="64" class="landing-icon landing-icon--feature" aria-hidden="true" />
                        </div>
                        <h5 class="card-title text-primary fw-bold">User Management</h5>
                        <p class="card-text text-muted">
                            Complete user lifecycle management with roles, permissions, and SSO capabilities.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="mb-3">
                            <img src="~/svgs/icons/features/easy-integration.svg" alt="" width="64" height="64" class="landing-icon landing-icon--feature" aria-hidden="true" />
                        </div>
                        <h5 class="card-title text-primary fw-bold">Easy Integration</h5>
                        <p class="card-text text-muted">
                            Seamless integration with your blog platform, APIs, and third-party services.
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="mb-3">
                            <img src="~/svgs/icons/features/modern-ui.svg" alt="" width="64" height="64" class="landing-icon landing-icon--feature" aria-hidden="true" />
                        </div>
                        <h5 class="card-title text-primary fw-bold">Modern UI</h5>
                        <p class="card-text text-muted">
                            Beautiful, responsive interface that works perfectly on all devices.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- How It Works Section -->
    <div class="bg-light py-5 mb-5 border-top border-gray-200 pt-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-primary">How It Works</h2>
                <p class="lead text-muted">Get started in three simple steps</p>
            </div>
            
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                             style="width: 80px; height: 80px;">
                            <span class="text-white fw-bold fs-2">1</span>
                        </div>
                        <h4 class="text-primary fw-bold">Connect</h4>
                        <p class="text-muted">
                            Integrate your blog or application using our simple APIs and SDKs.
                        </p>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                             style="width: 80px; height: 80px;">
                            <span class="text-white fw-bold fs-2">2</span>
                        </div>
                        <h4 class="text-primary fw-bold">Authenticate</h4>
                        <p class="text-muted">
                            Enable secure user authentication with modern protocols and flows.
                        </p>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                             style="width: 80px; height: 80px;">
                            <span class="text-white fw-bold fs-2">3</span>
                        </div>
                        <h4 class="text-primary fw-bold">Manage</h4>
                        <p class="text-muted">
                            Control users, roles, and permissions through our intuitive dashboard.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links Section -->
    <div class="container mb-5 border-top border-gray-200 pt-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-primary">Quick Access</h3>
            <p class="text-muted">Essential tools and resources for developers</p>
        </div>
        
        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6">
                <a href="~/.well-known/openid-configuration" class="card text-decoration-none border-0 shadow-sm h-100">
                    <div class="card-body d-flex gap-3 justify-content-between align-items-center p-4">
                        <img src="~/svgs/icons/quick-access/discovery-document.svg" alt="" width="32" height="32" class="landing-icon landing-icon--quick me-3" aria-hidden="true" />
                        <div>
                            <h6 class="card-title mb-0 text-primary">Discovery Document</h6>
                            <small class="text-muted">OpenID configuration</small>
                        </div>
                    </div>
                </a>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <a href="~/diagnostics" class="card text-decoration-none border-0 shadow-sm h-100">
                    <div class="card-body d-flex gap-3 justify-content-between align-items-center p-4">
                        <img src="~/svgs/icons/quick-access/session-claims.svg" alt="" width="32" height="32" class="landing-icon landing-icon--quick me-3" aria-hidden="true" />
                        <div>
                            <h6 class="card-title mb-0 text-primary">Session Claims</h6>
                            <small class="text-muted">View current session</small>
                        </div>
                    </div>
                </a>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <a href="~/grants" class="card text-decoration-none border-0 shadow-sm h-100">
                    <div class="card-body d-flex gap-3 justify-content-between align-items-center p-4">
                        <img src="~/svgs/icons/quick-access/grants.svg" alt="" width="32" height="32" class="landing-icon landing-icon--quick me-3" aria-hidden="true" />
                        <div>
                            <h6 class="card-title mb-0 text-primary">Manage Grants</h6>
                            <small class="text-muted">Authorization grants</small>
                        </div>
                    </div>
                </a>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <a href="~/serversidesessions" class="card text-decoration-none border-0 shadow-sm h-100">
                    <div class="card-body d-flex gap-3 justify-content-between align-items-center p-4">
                        <img src="~/svgs/icons/quick-access/server-sessions.svg" alt="" width="32" height="32" class="landing-icon landing-icon--quick me-3" aria-hidden="true" />
                        <div>
                            <h6 class="card-title mb-0 text-primary">Server Sessions</h6>
                            <small class="text-muted">Active sessions</small>
                        </div>
                    </div>
                </a>
            </div>
        </div>
        
        <div class="row g-4 justify-content-center">
            <div class="col-lg-4 col-md-6">
                <a href="~/ciba/all" class="card text-decoration-none border-0 shadow-sm h-100">
                    <div class="card-body d-flex gap-3 justify-content-around align-items-center p-4">
                        <img src="~/svgs/icons/quick-access/ciba-requests.svg" alt="" width="32" height="32" class="landing-icon landing-icon--quick me-3" aria-hidden="true" />
                        <div>
                            <h6 class="card-title mb-0 text-primary">CIBA Requests</h6>
                            <small class="text-muted">Pending authentication</small>
                        </div>
                    </div>
                </a>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <a href="https://github.com/duendesoftware/IdentityServer" class="card text-decoration-none border-0 shadow-sm h-100">
                    <div class="card-body d-flex gap-3 justify-content-around align-items-center p-4">
                        <img src="~/svgs/icons/quick-access/source-code.svg" alt="" width="32" height="32" class="landing-icon landing-icon--quick me-3" aria-hidden="true" />
                        <div>
                            <h6 class="card-title mb-0 text-primary">Source Code</h6>
                            <small class="text-muted">GitHub repository</small>
                        </div>
                    </div>
                </a>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <a href="https://github.com/duendesoftware/samples" class="card text-decoration-none border-0 shadow-sm h-100">
                    <div class="card-body d-flex gap-3 justify-content-around align-items-center p-4">
                        <img src="~/svgs/icons/quick-access/sample-projects.svg" alt="" width="32" height="32" class="landing-icon landing-icon--quick me-3" aria-hidden="true" />
                        <div>
                            <h6 class="card-title mb-0 text-primary">Sample Projects</h6>
                            <small class="text-muted">Example implementations</small>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    @if(Model.License != null)
    {
        <div class="container mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary fw-bold">License Information</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <strong>Serial Number:</strong> @Model.License.SerialNumber
                        </div>
                        <div class="col-md-6">
                            <strong>Expiration:</strong> @Model.License.Expiration!.Value.ToLongDateString()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/welcome.css?v=@DateTime.Now.Ticks" />
}
