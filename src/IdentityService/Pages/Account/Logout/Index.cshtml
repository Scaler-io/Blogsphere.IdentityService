@page
@model IdentityService.Pages.Logout.Index
@{
    ViewData["Title"] = "Logout";
    Layout = "_AccountPageLayout";
    ViewData["LayoutVariant"] = "split-card";
    ViewData["IllustrationPath"] = "~/svgs/illustrations/auth/logout.svg";
    ViewData["IllustrationWidth"] = 240;
    ViewData["IllustrationHeight"] = 180;
    ViewData["PageTitle"] = "Sign Out";
    ViewData["PageSubtitle"] = null;
}

<p class="logout-description">
    You are about to sign out of your Blogsphere account. You will need to sign in again to access your account.
</p>

<form asp-page="/Account/Logout/Index" class="account-form">
    <input type="hidden" name="logoutId" value="@Model.LogoutId" />

    <div class="logout-button-group">
        <button type="submit" class="btn-continue">Yes, Sign Out</button>
        <a href="/" class="btn-cancel">Cancel</a>
    </div>
</form>
