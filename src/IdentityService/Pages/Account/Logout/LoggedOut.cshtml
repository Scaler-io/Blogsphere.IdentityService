@page
@model IdentityService.Pages.Logout.LoggedOut
@{
    ViewData["Title"] = "Logged Out";
    Layout = "_AccountPageLayout";
    ViewData["IllustrationPath"] = "~/svgs/illustrations/auth/logged-out.svg";
    ViewData["PageTitle"] = "Successfully Signed Out";
    ViewData["PageSubtitle"] = "You have been safely logged out of Blogsphere";
}

<p class="logout-description">
    Your session has been securely terminated. Thank you for using Blogsphere!
</p>

<div class="decorative-elements">
    <img src="~/svgs/illustrations/auth/logged-out-decoration.svg" alt="" width="200" height="80" class="decoration-svg" aria-hidden="true" />
</div>

@if (Model.View.PostLogoutRedirectUri != null)
{
    <div class="logged-out-actions">
        <p class="redirect-text">Redirecting you back to <strong>@Model.View.ClientName</strong>...</p>
        <a href="@Model.View.PostLogoutRedirectUri" class="btn-continue">Continue to @Model.View.ClientName</a>
    </div>
}
else
{
    <div class="logged-out-actions">
        <a href="/Account/Login" class="btn-continue">Sign In Again</a>
        <a href="/" class="btn-cancel">Go to Homepage</a>
    </div>
}

@if (Model.View.SignOutIframeUrl != null)
{
    <iframe width="0" height="0" class="signout" src="@Model.View.SignOutIframeUrl"></iframe>
}

@section scripts
{
    @if (Model.View.AutomaticRedirectAfterSignOut)
    {
        <script src="~/js/signout-redirect.js"></script>
    }
}
