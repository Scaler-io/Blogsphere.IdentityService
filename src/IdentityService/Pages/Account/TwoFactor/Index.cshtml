@page
@model IdentityService.Pages.Account.TwoFactor.Index
@{
    Layout = "_AccountPageLayout";
    ViewData["Title"] = "Two-Factor Authentication";
    ViewData["LayoutVariant"] = "card";
    ViewData["IllustrationPath"] = "~/svgs/illustrations/auth/two-factor.svg";
    ViewData["IllustrationWidth"] = 280;
    ViewData["IllustrationHeight"] = 140;
    ViewData["PageTitle"] = "2FA Verification";
    ViewData["PageSubtitle"] = "Enter the 6-digit code sent to your email";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert-success-banner">
        <img src="~/svgs/icons/ui/check-circle.svg" alt="" width="24" height="24" class="status-icon status-icon--md" aria-hidden="true" />
        @Model.StatusMessage
    </div>
}

<form method="post" class="account-form account-form--otp" novalidate>
    <div class="form-group">
        <div class="blogsphere-otp" data-otp-input data-otp-target="Code">
            @for (var i = 0; i < 6; i++)
            {
                <input type="text"
                       class="blogsphere-otp__digit"
                       maxlength="1"
                       inputmode="numeric"
                       pattern="[0-9]"
                       autocomplete="@(i == 0 ? "one-time-code" : "off")"
                       aria-label="Digit @(i + 1) of 6"
                       data-otp-digit />
            }
        </div>
        <input type="text"
               asp-for="Code"
               class="blogsphere-otp__hidden"
               tabindex="-1"
               aria-hidden="true"
               autocomplete="one-time-code" />
        <span asp-validation-for="Code" class="text-danger validation-error"></span>
    </div>

    <div class="form-actions">
        <button class="btn-continue" name="button" value="submit" type="submit">
            Verify
        </button>
    </div>
</form>

@section BelowCard {
    <partial name="_BlogsphereInfoBanner" />
    <div class="account-page__help-links">
        <form method="post" asp-page-handler="Resend" class="resend-form" id="resendForm">
            <button type="submit" class="account-page__help-link resend-link" id="resendBtn" data-cooldown="30" disabled="disabled">
                <span id="resendText">Resend Code</span>
                <span id="resendTimer" class="resend-timer">(30s)</span>
            </button>
        </form>
    </div>
}

@section scripts {
    <script src="~/js/twofactor-resend.js?v=@DateTime.Now.Ticks"></script>
}
