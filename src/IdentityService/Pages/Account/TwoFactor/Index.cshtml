@page
@model IdentityService.Pages.Account.TwoFactor.Index
@{
    Layout = "_AccountPageLayout";
    ViewData["Title"] = "Two-Factor Authentication";
    ViewData["IllustrationPath"] = "~/svgs/illustrations/auth/two-factor.svg";
    ViewData["PageTitle"] = "2FA Verification";
    ViewData["PageSubtitle"] = "Please enter the verification code sent to your email.";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert-success-banner">
        <img src="~/svgs/icons/ui/check-circle.svg" alt="" width="24" height="24" class="status-icon status-icon--md" aria-hidden="true" />
        @Model.StatusMessage
    </div>
}

<form method="post" class="account-form account-form--otp" novalidate>
    <div class="form-group">
        <label asp-for="Code">Verification Code</label>
        <input type="text"
               maxlength="6"
               class="form-control"
               placeholder="Enter code"
               autocomplete="one-time-code"
               inputmode="numeric"
               asp-for="Code" />
        <span asp-validation-for="Code" class="text-danger validation-error"></span>
    </div>

    <div class="form-actions">
        <button class="btn-continue" name="button" value="submit" type="submit">
            Verify
        </button>
    </div>
</form>

<div class="account-page__help-links">
    <div class="notice-banner">
        <img src="~/svgs/icons/ui/info-circle.svg" alt="" width="24" height="24" class="status-icon status-icon--md" aria-hidden="true" />
        <span>Please do not refresh or leave this page. Your verification session will expire.</span>
    </div>

    <ul class="account-page__help-list">
        <li>
            <form method="post" asp-page-handler="Resend" class="resend-form" id="resendForm">
                <button type="submit" class="resend-link" id="resendBtn" data-cooldown="30" disabled="disabled">
                    <img src="~/svgs/icons/ui/refresh.svg" alt="" width="24" height="24" class="status-icon status-icon--md" aria-hidden="true" />
                    <span id="resendText">Resend Code</span>
                    <span id="resendTimer" class="resend-timer">(30s)</span>
                </button>
            </form>
        </li>
        <li>
            <a href="mailto:support@blogsphere.com" class="account-page__help-link">
                <img src="~/svgs/icons/ui/envelope.svg" alt="" width="24" height="24" class="status-icon status-icon--md" aria-hidden="true" />
                Contact Support
            </a>
        </li>
    </ul>
</div>

@section scripts {
    <script src="~/js/twofactor-resend.js?v=@DateTime.Now.Ticks"></script>
}
