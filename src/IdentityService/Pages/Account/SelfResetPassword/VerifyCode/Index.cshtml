@page
@model IdentityService.Pages.Account.SelfResetPassword.VerifyCode.Index
@{
    ViewData["Title"] = "Verify One-Time Code";
    Layout = "_AccountPageLayout";
    ViewData["LayoutVariant"] = "card";
    ViewData["IllustrationPath"] = "~/svgs/illustrations/auth/verify-code.svg";
    ViewData["PageTitle"] = "Verify One-Time Code";
    ViewData["PageSubtitle"] = "Send and verify a one-time code before changing password.";
}

@section BackNav {
    <a class="account-page__back-link"
       href="#"
       onclick="event.preventDefault(); if (window.history.length > 1) { window.history.back(); } else { window.location.href='@Url.Page("/Account/SelfResetPassword/Index", new { returnUrl = Model.Input.ReturnUrl, clientId = Model.Input.ClientId })'; }">&larr; Back</a>
}

<form method="post" class="account-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger validation-summary-errors"></div>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="manage-status-message">@Model.StatusMessage</div>
    }

    <input type="hidden" asp-for="Input.ReturnUrl" />
    <input type="hidden" asp-for="Input.Email" />
    <input type="hidden" asp-for="Input.ClientId" />

    <div class="blogsphere-field">
        <label class="blogsphere-field__label" for="Input_Email">Email</label>
        <div class="blogsphere-field__control-wrap">
            <img src="~/svgs/icons/ui/envelope.svg" alt="" class="blogsphere-field__icon" aria-hidden="true" />
            <input type="email" id="Input_Email" class="blogsphere-field__input" asp-for="Input.Email" readonly />
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-continue" name="Input.Action" value="sendCode">Send One-Time Code</button>
    </div>

    <div class="form-group">
        <div class="blogsphere-otp" data-otp-input data-otp-target="Input_OneTimeCode">
            @for (var i = 0; i < 6; i++)
            {
                <input type="text"
                       class="blogsphere-otp__digit"
                       maxlength="1"
                       inputmode="numeric"
                       pattern="[0-9]"
                       autocomplete="@(i == 0 ? "one-time-code" : "off")"
                       aria-label="Digit @(i + 1) of 6"
                       data-otp-digit />
            }
        </div>
        <input type="text"
               asp-for="Input.OneTimeCode"
               class="blogsphere-otp__hidden"
               tabindex="-1"
               aria-hidden="true"
               autocomplete="one-time-code" />
        <span asp-validation-for="Input.OneTimeCode" class="text-danger validation-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-continue" name="Input.Action" value="verifyCode">Verify Code</button>
    </div>
</form>

