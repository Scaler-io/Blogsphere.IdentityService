@page
@model IdentityService.Pages.Account.Login.Index
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AccountPageLayout";
    ViewData["IllustrationPath"] = "~/svgs/illustrations/auth/login.svg";
    ViewData["PageTitle"] = "Welcome Back";
    ViewData["PageSubtitle"] = "Please sign in to your account";
}

<form asp-page="/Account/Login/Index" method="post" class="account-form" novalidate>
    <input type="hidden" asp-for="Input.ReturnUrl" />
    <input type="hidden" asp-for="Input.Button" value="login" />

    <div class="form-group">
        <input type="email"
               class="form-control"
               autocomplete="email"
               placeholder="Email*"
               asp-for="Input.Username" />
        <span asp-validation-for="Input.Username" class="text-danger validation-error"></span>
    </div>

    <div class="form-group">
        <input type="password"
               class="form-control"
               autocomplete="current-password"
               placeholder="Password*"
               asp-for="Input.Password" />
        <span asp-validation-for="Input.Password" class="text-danger validation-error"></span>
    </div>

    @if (Model.View.AllowRememberLogin)
    {
        <div class="form-group remember-section">
            <label class="remember-checkbox">
                <input type="checkbox" asp-for="Input.RememberLogin">
                <span class="checkmark"></span>
                <span class="remember-text">Remember my email</span>
            </label>
        </div>
    }

    <div class="form-actions">
        <button type="submit" class="btn-continue">
            Continue
        </button>
    </div>

    <div class="form-links">
        @if (Model.View.ShowSignup)
        {
            <p class="signup-link">
                Not registered? <a href="#" class="link-primary">Sign up</a>
            </p>
        }
        <p class="forgot-link">
            <a asp-page="/Account/ForgotPassword/Index"
               asp-route-email="@Model.Input?.Username"
               asp-route-returnUrl="@Model.Input?.ReturnUrl"
               class="link-secondary">I don't remember my password</a>
        </p>
    </div>

    @if (Model.View.VisibleExternalProviders.Any())
    {
        <div class="external-providers">
            <div class="divider">
                <span>or continue with</span>
            </div>
            <div class="external-buttons">
                @foreach (var provider in Model.View.VisibleExternalProviders)
                {
                    <a class="btn-external" asp-page="/ExternalLogin/Challenge"
                       asp-route-scheme="@provider.AuthenticationScheme"
                       asp-route-returnUrl="@Model.Input.ReturnUrl">
                        @provider.DisplayName
                    </a>
                }
            </div>
        </div>
    }
</form>
