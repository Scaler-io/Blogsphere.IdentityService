@page
@model IdentityService.Pages.Account.Login.Index
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AccountPageLayout";
    ViewData["LayoutVariant"] = "card";
    ViewData["IllustrationPath"] = "~/svgs/illustrations/auth/login.svg";
    ViewData["IllustrationWidth"] = 280;
    ViewData["IllustrationHeight"] = 140;
    ViewData["PageTitle"] = "Welcome Back";
    ViewData["PageSubtitle"] = "Please sign in to your account";
}

<form asp-page="/Account/Login/Index" method="post" class="account-form" novalidate>
    <input type="hidden" asp-for="Input.ReturnUrl" />
    <input type="hidden" asp-for="Input.Button" value="login" />

    <div class="blogsphere-field">
        <label class="blogsphere-field__label" for="Input_Username">Email</label>
        <div class="blogsphere-field__control-wrap">
            <img src="~/svgs/icons/ui/envelope.svg" alt="" class="blogsphere-field__icon" aria-hidden="true" />
            <input type="email"
                   id="Input_Username"
                   class="blogsphere-field__input"
                   autocomplete="email"
                   placeholder="Enter your email"
                   asp-for="Input.Username" />
        </div>
        <span asp-validation-for="Input.Username" class="blogsphere-field__error validation-error"></span>
    </div>

    <div class="blogsphere-field">
        <label class="blogsphere-field__label" for="Input_Password">Password</label>
        <div class="blogsphere-field__control-wrap">
            <img src="~/svgs/icons/ui/lock.svg" alt="" class="blogsphere-field__icon" aria-hidden="true" />
            <input type="password"
                   id="Input_Password"
                   class="blogsphere-field__input"
                   autocomplete="current-password"
                   placeholder="Enter your password"
                   asp-for="Input.Password" />
            <button type="button" class="blogsphere-field__toggle" aria-label="Toggle password visibility" data-password-toggle>
                <img src="~/svgs/icons/ui/eye.svg" alt="" width="18" height="18" data-icon-show aria-hidden="true" />
                <img src="~/svgs/icons/ui/eye-off.svg" alt="" width="18" height="18" data-icon-hide hidden aria-hidden="true" />
            </button>
        </div>
        <span asp-validation-for="Input.Password" class="blogsphere-field__error validation-error"></span>
    </div>

    @if (Model.View.AllowRememberLogin)
    {
        <div class="form-group remember-section">
            <label class="remember-checkbox">
                <input type="checkbox" asp-for="Input.RememberLogin">
                <span class="checkmark"></span>
                <span class="remember-text">Remember my email</span>
            </label>
        </div>
    }

    <div class="form-actions">
        <button type="submit" class="btn-continue">Sign In</button>
    </div>

    <div class="form-links">
        @if (Model.View.ShowSignup)
        {
            <p class="signup-link">
                Not registered? <a href="#" class="link-primary">Sign up</a>
            </p>
        }
        <p class="forgot-link">
            <a asp-page="/Account/ForgotPassword/Index"
               asp-route-email="@Model.Input?.Username"
               asp-route-returnUrl="@Model.Input?.ReturnUrl"
               class="link-secondary">Forgot password?</a>
        </p>
    </div>

    @if (Model.View.VisibleExternalProviders.Any())
    {
        <div class="external-providers">
            <div class="divider">
                <span>or continue with</span>
            </div>
            <div class="external-buttons">
                @foreach (var provider in Model.View.VisibleExternalProviders)
                {
                    <a class="btn-external" asp-page="/ExternalLogin/Challenge"
                       asp-route-scheme="@provider.AuthenticationScheme"
                       asp-route-returnUrl="@Model.Input.ReturnUrl">
                        @provider.DisplayName
                    </a>
                }
            </div>
        </div>
    }
</form>
