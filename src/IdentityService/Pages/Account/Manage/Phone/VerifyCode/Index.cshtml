@page
@model IdentityService.Pages.Account.Manage.Phone.VerifyCode.Index
@{
    ViewData["Title"] = "Verify Phone Number";
    Layout = "_AccountPageLayout";
    ViewData["IllustrationPath"] = "~/svgs/illustrations/auth/phone-verify.svg";
    ViewData["PageTitle"] = "Verify Phone Number";
    ViewData["PageSubtitle"] = !string.IsNullOrEmpty(Model.MaskedPhone)
        ? $"Send a verification code to your email and enter it below to confirm phone number <strong>{Model.MaskedPhone}</strong>."
        : "Send a verification code to your email and enter it below to confirm your phone number.";
}

@section BackNav {
    <a class="account-page__back-link"
       asp-page="/Account/Manage/Phone/Index"
       asp-route-returnUrl="@Model.Input.ReturnUrl"
       asp-route-clientId="@Model.Input.ClientId">&larr; Back</a>
}

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="manage-status-message">@Model.StatusMessage</div>
}

<form method="post" class="account-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger validation-summary-errors"></div>
    <input type="hidden" asp-for="Input.ReturnUrl" />
    <input type="hidden" asp-for="Input.ClientId" />

    <div class="form-actions">
        <button type="submit" class="btn-continue" name="Input.Action" value="sendCode">Send Verification Code</button>
    </div>

    <div class="form-group">
        <input type="text"
               class="form-control"
               asp-for="Input.VerificationCode"
               placeholder="Enter verification code"
               autocomplete="one-time-code"
               inputmode="numeric"
               maxlength="6" />
        <span asp-validation-for="Input.VerificationCode" class="text-danger validation-error"></span>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-continue" name="Input.Action" value="verifyCode">Verify Phone Number</button>
    </div>
</form>
