<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />

    <title>@ViewData["Title"] - Blogsphere Identity</title>
    
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg?v=@DateTime.Now.Ticks" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png?v=@DateTime.Now.Ticks" />
    
    <link rel="stylesheet" href="~/fonts/titillium-web/titillium-web.css" />
    <link rel="stylesheet" href="~/fonts/open-sans/open-sans.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/bootstrap4-glyphicons/css/bootstrap-glyphicons.css" />
    <link rel="stylesheet" href="~/css/site.css?v=@DateTime.Now.Ticks" />

    @if (ViewData["UseAccountPageAssets"] is true)
    {
        <link rel="stylesheet" href="~/css/pages/account-flows.css?v=@DateTime.Now.Ticks" />
    }
    
    @RenderSection("Styles", required: false)
</head>
<body class="blogsphere-page @(ViewData["BodyClass"] as string)">
    <partial name="_BlogsphereNav" />

    <main class="blogsphere-page__main" role="main">
        @RenderBody()
    </main>

    <partial name="_BlogsphereFooter" />

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>

    @if (ViewData["UseAccountPageAssets"] is true)
    {
        <partial name="_ValidationScriptsPartial" />
        <script src="~/js/otp-input.js?v=@DateTime.Now.Ticks"></script>
    }

    @RenderSection("scripts", required: false)
</body>
</html>
